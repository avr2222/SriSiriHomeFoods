# ── Sri Siri — Supabase admin / CLI env ──────────────────────
# Copy to `supabase/.env` for local CLI work (migrations, db push,
# seeding, admin scripts). These are SERVER-ONLY secrets — they are
# NOT prefixed VITE_ and must never reach the browser apps.
#
# .env and .env.* are git-ignored (see root .gitignore).

# Project ref + DB connection (Dashboard → Project Settings → Database)
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF
SUPABASE_DB_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Service role key — FULL ADMIN, bypasses RLS. Server/CLI use only.
# (Dashboard → Project Settings → API → service_role secret)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Convenience copies for one-off admin scripts (optional)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY
