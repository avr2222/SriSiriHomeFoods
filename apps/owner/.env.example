# ── Sri Siri — Owner cockpit env ─────────────────────────────
# Copy this file to `.env` (in apps/owner/) and fill in your
# Supabase project values. Vite only exposes vars prefixed VITE_.
#
# Find both in the Supabase dashboard → Project Settings → API.
# Use the SAME project as the customer app. The anon key is the
# PUBLIC, RLS-protected key; admin access is granted by the
# super_admin role, not by the key. NEVER put service_role here.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
