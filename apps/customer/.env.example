# ── Sri Siri — Customer app env ──────────────────────────────
# Copy this file to `.env` (in apps/customer/) and fill in your
# Supabase project values. Vite only exposes vars prefixed VITE_.
#
# Find both in the Supabase dashboard → Project Settings → API.
# The anon key is the PUBLIC, RLS-protected key — it is safe to ship
# in a client app. NEVER put the service_role key here.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
